# Copy to .env and fill in. .env is gitignored — never commit real keys.

# MiniMax API key, used by the OpenCode agent via the `minimax` provider.
MINIMAX_API_KEY=

# Fallback route: OpenCode's OpenAI-compatible provider pointed at MiniMax.
# Use with `-m openai/MiniMax-M2.7` if the `minimax/` provider fails to auth.
OPENAI_API_KEY=${MINIMAX_API_KEY}
OPENAI_BASE_URL=https://api.minimax.io/v1
